rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function participant(data) {
      return signedIn()
        && data.keys().hasAll(['participantIds'])
        && request.auth.uid in data.participantIds;
    }
    // Web records created before the unified participantIds field remain
    // readable only by an explicitly recorded trade party.
    function ownsLegacyRecord(data) {
      return signedIn() && (
        (data.keys().hasAll(['ownerId']) && data.ownerId == request.auth.uid) ||
        (data.keys().hasAll(['buyerId']) && data.buyerId == request.auth.uid) ||
        (data.keys().hasAll(['supplierId']) && data.supplierId == request.auth.uid) ||
        (data.keys().hasAll(['sellerId']) && data.sellerId == request.auth.uid) ||
        (data.keys().hasAll(['exporterId']) && data.exporterId == request.auth.uid)
      );
    }
    function participantOrOwner(data) {
      return participant(data) || ownsLegacyRecord(data);
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid
        && request.resource.data.role in ['supplier', 'exporter', 'buyer']
        && request.resource.data.kycStatus == 'pending'
        && request.resource.data.accountStatus == 'active';
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.id == resource.data.id
        && request.resource.data.kycStatus == resource.data.kycStatus
        && request.resource.data.accountStatus == resource.data.accountStatus
        && (
          (request.resource.data.role == resource.data.role
            && request.resource.data.roles == resource.data.roles)
          || (resource.data.roleSelectionPending == true
            && request.resource.data.role in ['supplier', 'exporter', 'buyer']
            && request.resource.data.roles == [request.resource.data.role]
            && request.resource.data.roleSelectionPending == false)
        );
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if participant(resource.data);
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if participant(resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.id == resource.data.id
        && request.resource.data.lotId == resource.data.lotId;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && participant(get(/databases/$(database)/documents/conversations/$(conversationId)).data);
        allow update, delete: if false;
      }
    }

    match /rfqs/{rfqId} {
      allow read: if participantOrOwner(resource.data) ||
        (signedIn() && resource.data.status == 'open'
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              in ['supplier', 'exporter'] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessProfile.tradingCapabilities
              .hasAny(['seller'])
          ));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'open'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ['buyer', 'exporter'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessProfile.tradingCapabilities
            .hasAny(['buyer'])
        );
      allow update: if participant(resource.data)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /lots/{lotId} {
      allow read: if signedIn() &&
        (resource.data.status == 'active' || participantOrOwner(resource.data));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ['supplier', 'exporter'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessProfile.tradingCapabilities
            .hasAny(['seller'])
        );
      allow update: if participant(resource.data)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /export_orders/{orderId} {
      allow read: if participantOrOwner(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.exporterId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'draft'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == 'exporter'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.kycStatus
          == 'verified';
      allow update: if participant(resource.data)
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.entityType is string
        && request.resource.data.entityId is string
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /offers/{offerId} {
      allow read: if participantOrOwner(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.supplierId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.status == 'submitted'
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
            in ['supplier', 'exporter'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessProfile.tradingCapabilities
            .hasAny(['seller'])
        )
        && get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.status
          == 'open'
        && get(/databases/$(database)/documents/rfqs/$(request.resource.data.rfqId)).data.ownerId
          == request.resource.data.buyerId
        && request.resource.data.buyerId in request.resource.data.participantIds;
      allow update: if participant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /service_requests/{requestId} {
      allow read: if participantOrOwner(resource.data);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.type in ['logistics', 'market_access']
        && request.resource.data.status == 'requested';
      allow update: if participant(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /{collection}/{documentId} {
      allow read: if participantOrOwner(resource.data);
      allow write: if false;
    }
  }
}
