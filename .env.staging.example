# AfriGo Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# ==================== GENERAL ====================
NODE_ENV=staging
PORT=3000
LOG_LEVEL=info
APP_NAME=AfriGo
APP_URL=https://staging.afrigo.com
API_URL=https://api.staging.afrigo.com

# ==================== DATABASE ====================
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=afrigo_staging
DATABASE_USER=afrigo_user
DATABASE_PASSWORD=change_this_secure_password
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false
DATABASE_POOL_SIZE=20

# ==================== REDIS ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==================== JWT ====================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_staging
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# ==================== STRIPE PAYMENTS ====================
STRIPE_SECRET_KEY=sk_test_51234567890abcdefghijk
STRIPE_PUBLISHABLE_KEY=pk_test_1234567890abcdefghijk
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdefghijklmnop
STRIPE_PLATFORM_FEE_PERCENT=2
STRIPE_API_VERSION=2022-11-15

# ==================== AWS S3 ====================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA1234567890ABCDEF
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_S3_BUCKET=afrigo-staging
AWS_S3_URL=https://afrigo-staging.s3.amazonaws.com

# ==================== EMAIL (SendGrid) ====================
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASSWORD=SG.your_sendgrid_api_key_here
MAIL_FROM=noreply@staging.afrigo.com
MAIL_FROM_NAME=AfriGo Staging

# ==================== ERROR TRACKING (Sentry) ====================
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILE_SAMPLE_RATE=0.1

# ==================== GOOGLE SERVICES ====================
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ==================== TWILIO (SMS/Phone Verification) ====================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==================== FIREBASE (Push Notifications) ====================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ==================== CLOUDINARY (Image Processing) ====================
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==================== PAGINATION ====================
DEFAULT_PAGE=1
DEFAULT_LIMIT=20
MAX_LIMIT=100

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:3000,https://staging.afrigo.com,https://api.staging.afrigo.com

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== FILE UPLOAD ====================
MAX_FILE_SIZE=52428800
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx

# ==================== CACHE ====================
CACHE_TTL=300
CACHE_ENABLED=true

# ==================== SESSION ====================
SESSION_SECRET=your_session_secret_key_change_this
SESSION_TIMEOUT=3600000

# ==================== ADMIN ====================
ADMIN_EMAIL=admin@staging.afrigo.com
ADMIN_DEFAULT_PASSWORD=ChangeMe@123456

# ==================== FEATURE FLAGS ====================
FEATURE_ESCROW_ENABLED=true
FEATURE_MESSAGING_ENABLED=true
FEATURE_RATINGS_ENABLED=true
FEATURE_ANALYTICS_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true

# ==================== PAGINATION & LIMITS ====================
LOT_IMAGES_MAX=10
MESSAGE_MAX_LENGTH=5000
QUOTE_VALIDITY_DAYS=7
ORDER_COMPLETION_DAYS=30

# ==================== API DOCUMENTATION ====================
SWAGGER_ENABLED=true
SWAGGER_TITLE=AfriGo API
SWAGGER_DESCRIPTION=Agricultural Marketplace API
SWAGGER_VERSION=1.0.0

# ==================== DEVELOPER CREDENTIALS ====================
# Test Accounts for Internal Testing
TEST_ADMIN_EMAIL=admin@staging.afrigo.com
TEST_ADMIN_PASSWORD=TestAdmin@123456
TEST_SELLER_EMAIL=seller@staging.afrigo.com
TEST_SELLER_PASSWORD=TestSeller@123456
TEST_BUYER_EMAIL=buyer@staging.afrigo.com
TEST_BUYER_PASSWORD=TestBuyer@123456

# ==================== MONITORING ====================
METRICS_ENABLED=true
PROFILING_ENABLED=false
DEBUG_LOGGING=false

# ==================== THIRD-PARTY WEBHOOKS ====================
STRIPE_WEBHOOK_PORT=3000
STRIPE_WEBHOOK_PATH=/api/webhooks/stripe

# ==================== SECURITY ====================
BCRYPT_ROUNDS=10
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=Strict

# ==================== DEPLOYMENT ====================
DEPLOYMENT_ENV=staging
DEPLOYMENT_REGION=us-east-1
DEPLOYMENT_VERSION=1.0.0
BUILD_ID=staging-build-001

# ==================== MAINTENANCE ====================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System is under maintenance

# ==================== PHONE & SMS ====================
PHONE_VERIFICATION_ENABLED=true
SMS_PROVIDER=twilio

# Notes:
# - Keep sensitive values secure - never commit to git
# - Use strong, random passwords (min 16 characters)
# - Rotate API keys regularly
# - Store in secure secret management (e.g., AWS Secrets Manager, HashiCorp Vault)
# - Different values required for each environment (staging/production)
# - Document any custom environment variables not listed here
